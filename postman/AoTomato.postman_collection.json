  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\",\n  \"remindMe\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Initial Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/login/initialCheck",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "login", "initialCheck"]
            }
          }
        },
        {
          "name": "Initial Setup",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin\",\n  \"userEmail\": \"admin@admin.com\",\n  \"userPassword\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/login/initialSetup",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "login", "initialSetup"]
            }
          }
        }
      ]
    },
