{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build & Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/AoTomato.API/bin/Debug/net10.0/AoTomato.API.dll",
      "cwd": "${workspaceFolder}/src/AoTomato.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5142",
        "DbSettings__ConnectionString": "aotomato.db"
      }
    },
    {
      "name": "Launch Hosted Blazor WASM (Chrome)",
      "type": "blazorwasm",
      "request": "launch",
      "hosted": true,
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/AoTomato.API/bin/Debug/net10.0/AoTomato.API.dll",
      "cwd": "${workspaceFolder}/src/AoTomato.API",
      "url": "http://localhost:5142",
      "browser": "chrome",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5142",
        "DbSettings__ConnectionString": "aotomato.db"
      }
    }
  ]
}
