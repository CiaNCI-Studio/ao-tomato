<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AoTomato.Admin/AoTomato.Admin.csproj" />
    <ProjectReference Include="../AoTomato.Domain/AoTomato.Domain.csproj" />
    <ProjectReference Include="../AoTomato.Repositories/AoTomato.Repositories.csproj" />
    <ProjectReference Include="../AoTomato.Services/AoTomato.Services.csproj" />
  </ItemGroup>

  <Target Name="CopyBlazorWasmOutput" AfterTargets="AfterBuild">
    <PropertyGroup>
      <AdminOutputPath>$(MSBuildProjectDirectory)\..\AoTomato.Admin\bin\$(Configuration)\net10.0\wwwroot</AdminOutputPath>
    </PropertyGroup>
    <RemoveDir Directories="$(OutputPath)wwwroot\_framework" />
    <ItemGroup>
      <BlazorWasmFiles Include="$(AdminOutputPath)\_framework\**\*" />
      <BlazorWasmIndex Include="$(MSBuildProjectDirectory)\..\AoTomato.Admin\wwwroot\index.html" />
    </ItemGroup>
    <Copy SourceFiles="@(BlazorWasmFiles)"
          DestinationFolder="$(OutputPath)wwwroot\_framework\%(RecursiveDir)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(BlazorWasmIndex)"
          DestinationFolder="$(OutputPath)wwwroot\"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
