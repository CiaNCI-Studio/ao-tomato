@page "/initial-setup"
@inherits PageBase
@layout AoTomato.Admin.Layout.MainLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 80vh;">
    <MudCard Elevation="4" Class="pa-6 flex-grow-1" Style="max-width: 400px;">
        <MudCardContent>
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Initial Setup</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-4">Create the first administrator account.</MudText>
            <MudForm @ref="form" @bind-IsValid="isFormValid">
                <MudTextField @bind-Value="userName"
                              Label="Name"
                              Variant="Variant.Outlined"
                              Required="true"
                              Immediate="true"
                              Margin="Margin.Dense"
                              id="input-name" />
                <MudTextField @bind-Value="email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              Immediate="true"
                              Margin="Margin.Dense"
                              id="input-email" />
                <MudTextField @bind-Value="password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Required="true"
                              Immediate="true"
                              Margin="Margin.Dense"
                              id="input-password" />
                <MudTextField @bind-Value="confirmPassword"
                              Label="Confirm Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Required="true"
                              Immediate="true"
                              Margin="Margin.Dense"
                              id="input-confirm-password" />
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SetupAsync"
                       Disabled="@isLoading"
                       id="btn-confirm-setup">
                @(isLoading ? "Setting up..." : "Confirm")
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm? form;
    private string userName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private bool isFormValid;
    private bool isLoading;

    protected override async Task CheckAuthAsync()
    {
        var isInitialSetup = await AdminService.InitialCheckAsync();
        if (!isInitialSetup)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        IsAuthenticated = true;
    }

    protected override Task LoadDataAsync() => Task.CompletedTask;

    private async Task SetupAsync()
    {
        if (!isFormValid)
        {
            ShowError("Please fill all required fields.");
            return;
        }

        if (password != confirmPassword)
        {
            ShowError("Passwords do not match.");
            return;
        }

        isLoading = true;
        try
        {
            var dto = new AoTomato.Domain.Login.Dtos.InitialSetupDto
            {
                UserName = userName,
                UserEmail = email,
                UserPassword = password
            };

            var success = await AdminService.InitialSetupAsync(dto);
            if (success)
            {
                ShowSuccess("Setup completed successfully. Please login.");
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                ShowError("Setup failed. Please try again.");
            }
        }
        catch (UnauthorizedAccessException)
        {
            await HandleUnauthorizedAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
