@page "/login"
@inherits PageBase
@layout AoTomato.Admin.Layout.MainLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 80vh;">
    <MudCard Elevation="4" Class="pa-6 flex-grow-1" Style="max-width: 400px;">
        <MudCardContent>
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Login</MudText>
            <MudForm @ref="form" @bind-IsValid="isFormValid">
                <MudTextField @bind-Value="username"
                              Label="Username"
                              Variant="Variant.Outlined"
                              Required="true"
                              Immediate="true"
                              For="() => username"
                              Margin="Margin.Dense"
                              id="input-username" />
                <MudTextField @bind-Value="password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Required="true"
                              Immediate="true"
                              For="() => password"
                              Margin="Margin.Dense"
                              id="input-password" />
                <MudCheckBox @bind-Checked="remindMe"
                             Label="Remember Me"
                             Color="Color.Primary"
                             T="bool"
                             id="input-remindme" />
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="LoginAsync"
                       Disabled="@isLoading"
                       id="btn-login">
                @(isLoading ? "Logging in..." : "Login")
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm? form;
    private string username = string.Empty;
    private string password = string.Empty;
    private bool remindMe;
    private bool isFormValid;
    private bool isLoading;

    protected override async Task CheckAuthAsync()
    {
        var isLoggedIn = await AdminService.CheckLoginAsync();
        if (isLoggedIn)
        {
            NavigationManager.NavigateTo("/functions");
            return;
        }

        IsAuthenticated = true;
    }

    protected override Task LoadDataAsync() => Task.CompletedTask;

    private async Task LoginAsync()
    {
        if (!isFormValid) return;

        isLoading = true;
        try
        {
            var isInitialSetup = await AdminService.InitialCheckAsync();
            if (isInitialSetup)
            {
                NavigationManager.NavigateTo("/initial-setup");
                return;
            }

            var success = await AdminService.LoginAsync(username, password, remindMe);
            if (success)
            {
                NavigationManager.NavigateTo("/functions");
            }
            else
            {
                ShowError("Invalid username or password.");
            }
        }
        catch (UnauthorizedAccessException)
        {
            await HandleUnauthorizedAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
